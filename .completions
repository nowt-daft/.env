#!/usr/bin/env bash

# SHOULD WE HAVE COMPLETIONS IN A PROJECT?
# YES.
# TODO: Add completions to sub-shell environments!
if [ -d $ROOT/.completions.d ]; then
	for script_name in $(ls $ROOT/.completions.d); do
		source $ROOT/.completions.d/$script_name
		complete -F "__$script_name" $script_name
	done
fi
