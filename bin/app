#!/usr/bin/env bash

source $BASHSTRAP
include sys
include print

CMDS="list create add remove"
PKGS=$HOME/packages

cmd=${1:-list}
shift

if ! [[ $CMDS = *$cmd* ]]; then
	print::hr
	print::error "💀 $cmd is not a known command"
	print::info "COMMANDS: $CMDS"
	print::hr
	print::bad-exit
	exit 1
fi

print::hr

function list {
	search="$@"
	if [ -z $search ]; then
		print::info "🗃️ Available Packages:"
		print::hr
		print::list $(ls $PKGS)
		return 0
	fi
	print::error "🔧 TODO: IMPLEMENT SEARCH FEATURE..."
	return 1
}

function create {
	echo "📁 Creating directory → $PKGS/$1"
	sys::mkdir::cd $PKGS/$1
	script INSTALL
}

function add {
	pkg=$1
	if ! [ -d $PKGS/$pkg ]; then
		print::error "🫣 Package $pkg does NOT exist."
		return 1
	fi
	println "📥 Running INSTALL script for $pkg"
	print::hr =
	cd $PKGS/$pkg
	if ./INSTALL; then
		print::hr =
		print::ok
	else
		print::hr x
		print::error "INSTALL script failed."
		return 2
	fi
}

function remove {
	print::error \
		"🔧 TODO: IMPLENT THE CALL OF UNINSTALL SCRIPT"
}

echo "🚀 app $cmd $@"
print::hr
if $cmd $@; then
	print::hr
	print::done
	exit
fi
print::hr
print::bad-exit $?
exit 10
