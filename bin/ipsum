#!/usr/bin/env bash

source $BASHSTRAP
include rand
include print

MODE=$1
LOWER=$2
UPPER=$3

if ! [ $MODE ]; then
	print::hr
	print::error "MISSING ARGUMENT"
	print::hr
	print::warning "USAGE: ipsum <mode> <min?> <max?>"
	print::warning "  mode: sentence|paragraph|page"
	print::hr
	exit 1
fi

if [ -z $UPPER ]; then
	UPPER=$LOWER
fi

print::hr +
case $MODE in
	sentence)
		rand::sentence $LOWER $UPPER && printf "\n" ;;
	paragraph)
		rand::paragraph $LOWER $UPPER ;;
	page)
		print::error "NOT YET IMPLEMENTED" && exit 2;;
	*)
		print::error "Mode $MODE does NOT exist." && exit 3 ;;
esac
print::hr
print::done
