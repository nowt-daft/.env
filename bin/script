#!/usr/bin/env bash

source $BASHSTRAP
include print

TYPE=$1
NAME=$2

if ! [ $TYPE ]; then
	print::hr
	print::error "MISSING ARGUMENT"
	print::hr
	print::warning "USAGE: script <type?> <name>"
	print::warning "  type is any installed interpreter"
	print::warning "  type default is bash"
	exit 1
fi

if ! [ $NAME ]; then
	NAME=$TYPE
	TYPE="bash"
fi

print::hr +
print::log "💎 Generating $TYPE script"

if ! echo -e "#!/usr/bin/env $TYPE\n" | cat > $NAME; then
	print::error "Unable to save -> 📂 $PWD/$NAME"
	print::bad-exit 2
	exit 2
fi

chmod +x $NAME
print::ok "📂 $PWD/$NAME -> 📄 +x $NAME"
print::hr
print::done
