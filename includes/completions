#!/usr/bin/env bash

function __script {
	COMPREPLY=( $( \
		compgen -W \
			"bash python php bun node lua" -- \
			${COMP_WORDS[1]} \
		) )
}

function __ipsum {
	COMPREPLY=( $( \
		compgen -W \
			"sentence paragraph page" -- \
			${COMP_WORDS[1]} \
		) )
}

complete -F __script  script
complete -F __ipsum   ipsum
