#!/usr/bin/env bash

source "$HOME/includes/bashstrap"
include sys

if ! sys::has git; then
	print::info "❌ git not installed."
	sudo $(sys::install) git
fi

read -p "🏋  username: " USERNAME
read -p "✉  email: " EMAIL

git config --global \
	user.name  $USERNAME
git config --global \
	user.email $EMAIL

declare -A info
info["USER"]=$USERNAME
info["EMAIL"]=$EMAIL

print::table info
