#!/usr/bin/env bash

source $HOME/includes/bashstrap
include sys

if ! sys::has kitty; then
	print::info "💾 DOWNLOADING KITTY..."
	sudo $(sys::install) kitty
fi

sys::mkdir ~/.config/kitty

if ! [ -d ~/.config/kitty/kitty-themes ]; then
	print::info "🖌  DOWNLOADING THEMES..."
	git clone \
		https://github.com/dexpota/kitty-themes.git \
		~/.config/kitty/kitty-themes
fi

ln -s kitty.conf ~/.config/kitty
ln -s theme.conf ~/.config/kitty

if sys::has gsettings; then
	gsettings \
		set \
		org.gnome.desktop.default-applications.terminal \
		exec \
		'kitty'
	echo 'kitty.desktop' > ~/.config/xdg-terminals.list
fi
