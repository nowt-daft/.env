#!/usr/bin/env bash

source $HOME/includes/bashstrap
include commands

if ! has kitty; then
	echo "💾 DOWNLOADING KITTY..."
	sudo $(installer) install kitty
fi

mkdir -p ~/.config/kitty

if ! [ -d ~/.config/kitty/kitty-themes ]; then
	echo "🖌  DOWNLOADING THEMES..."
	git clone \
		https://github.com/dexpota/kitty-themes.git \
		~/.config/kitty/kitty-themes
fi

cp -f kitty.conf ~/.config/kitty
cp -f theme.conf ~/.config/kitty

gsettings set org.gnome.desktop.default-applications.terminal exec 'kitty'
echo 'kitty.desktop' > ~/.config/xdg-terminals.list
