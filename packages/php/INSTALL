#!/usr/bin/env sh

source $HOME/includes/bashstrap
include sys

sudo $(sys::install) php-cli

SETUP_FILE="composer-setup.php"

php -r "copy('https://getcomposer.org/installer', '$SETUP_FILE');"

EXPECTED_CHECKSUM="$(php -r 'copy("https://composer.github.io/installer.sig", "php://stdout");')"
ACTUAL_CHECKSUM="$(php -r "echo hash_file('sha384', '$SETUP_FILE');")"


if [ "$EXPECTED_CHECKSUM" != "$ACTUAL_CHECKSUM" ]; then
    >&2 echo 'ERROR: Invalid installer checksum'
    rm $SETUP_FILE
    exit 1
fi

php $SETUP_FILE --install-dir=$HOME/.local/bin/ --filename=composer

RESULT=$?
rm $SETUP_FILE

if [[ $RESULT == 0 ]]; then
	# https://github.com/php/php-src/tree/master/ext
	composer global require \
		phpstan/php-8-stubs \
		php-stubs/wordpress-globals \
		php-stubs/wordpress-stubs \
		php-stubs/wordpress-tests-stubs \
		php-stubs/woocommerce-stubs \
		php-stubs/acf-pro-stubs \
		php-stubs/genesis-stubs \
		php-stubs/wp-cli-stubs \
		wpsyntex/polylang-stubs \
		stripe/stripe-php
fi
exit $RESULT
